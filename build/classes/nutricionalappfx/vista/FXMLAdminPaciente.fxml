<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="438.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLAdminPacienteController">
   <children>
      <TableView fx:id="tblTablaPacientes" layoutX="19.0" layoutY="60.0" prefHeight="360.0" prefWidth="647.0">
        <columns>
          <TableColumn prefWidth="48.5" text="Codigo" />
          <TableColumn prefWidth="95.5" text="Nombre" />
            <TableColumn prefWidth="111.5" text="Apellido Paterno" />
            <TableColumn prefWidth="104.0" text="Apellido  Materno" />
            <TableColumn prefWidth="87.0" text="Fecha Nacimiento" />
            <TableColumn prefWidth="126.0" text="Telefono de contacto" />
        </columns>
      </TableView>
      <TextField fx:id="tfBuscar" layoutX="67.0" layoutY="22.0" prefHeight="25.0" prefWidth="254.0" promptText="Buscar..." />
      <Button layoutX="328.0" layoutY="22.0" mnemonicParsing="false" onAction="#btnBuscar" text="Buscar" />
      <Button layoutX="519.0" layoutY="22.0" mnemonicParsing="false" onAction="#btnEditar" prefHeight="25.0" prefWidth="67.0" text="Edicion" />
      <Button layoutX="593.0" layoutY="22.0" mnemonicParsing="false" onAction="#btnBaja" prefHeight="25.0" prefWidth="60.0" text="Baja" />
      <Button layoutX="443.0" layoutY="22.0" mnemonicParsing="false" onAction="#btnAlta" prefHeight="25.0" prefWidth="67.0" text="Alta" />
      <ImageView fitHeight="35.0" fitWidth="39.0" layoutX="19.0" layoutY="17.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../recurso/back.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
