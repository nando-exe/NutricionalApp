<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLAdminPacienteController">
   <children>
      <TableView fx:id="tblTablaPacientes" layoutX="14.0" layoutY="60.0" prefHeight="616.0" prefWidth="960.0">
        <columns>
          <TableColumn prefWidth="85.5" text="Codigo" />
          <TableColumn prefWidth="163.0" text="Nombre" />
            <TableColumn prefWidth="155.5" text="Apellido Paterno" />
            <TableColumn prefWidth="144.0" text="Apellido  Materno" />
            <TableColumn prefWidth="168.0" text="Fecha Nacimiento" />
            <TableColumn prefWidth="243.0" text="Telefono de contacto" />
        </columns>
      </TableView>
      <TextField fx:id="tfBuscar" layoutX="79.0" layoutY="17.0" prefHeight="35.0" prefWidth="311.0" promptText="Buscar..." />
      <Button layoutX="401.0" layoutY="17.0" mnemonicParsing="false" onAction="#btnBuscar" prefHeight="35.0" prefWidth="67.0" text="Buscar" />
      <Button layoutX="556.0" layoutY="17.0" mnemonicParsing="false" onAction="#btnEditar" prefHeight="35.0" prefWidth="77.0" text="Edicion" />
      <Button layoutX="641.0" layoutY="17.0" mnemonicParsing="false" onAction="#btnBaja" prefHeight="35.0" prefWidth="77.0" text="Baja" />
      <Button layoutX="483.0" layoutY="17.0" mnemonicParsing="false" onAction="#btnAlta" prefHeight="35.0" prefWidth="67.0" text="Alta" />
      <ImageView fitHeight="35.0" fitWidth="39.0" layoutX="28.0" layoutY="17.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../recurso/back.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
